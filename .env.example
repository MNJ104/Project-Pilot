# ===================================================================
# Project Pilot - Environment Variables Template
# DO NOT COMMIT ACTUAL SECRETS TO GIT
# ===================================================================

# --- GENERAL & ENVIRONMENT ---
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# --- POSTGRES DATABASE ---
POSTGRES_DB=project_pilot
POSTGRES_USER=pilot_user
POSTGRES_PASSWORD=pilot_password_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- SPRING BOOT BACKEND ---
BACKEND_PORT=8080
JWT_SECRET=super_secret_jwt_key_at_least_64_characters_long_for_security_123456789
JWT_EXPIRATION_MS=86400000

# --- PYTHON AI SERVICE ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- GITHUB INTEGRATION ---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- FRONTEND & EXTENSION ---
VITE_BACKEND_URL=http://localhost:8080/api/v1
VITE_APP_NAME=Project Pilot
